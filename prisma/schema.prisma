// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // ✅ Usa Neon u otro Postgres
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  hash      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  cases     Case[]
}

enum Role {
  USER
  PARALEGAL
  ADMIN
}

enum CaseType {
  I589
  I765
}

enum CaseStatus {
  DRAFT
  READY_FOR_REVIEW
  FILED
  REJECTED
  APPROVED
}

model Case {
  id     String @id @default(cuid())
  type   String
  status String

  // 👇 lo que ya hablamos: que ownerId sea opcional
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // 👇 NUEVO: lado “opuesto” de la relación con Evidence
  evidences Evidence[] // nombre que tú quieras, pero que sea una lista
}

model Evidence {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  key        String
  name       String
  mime       String
  size       Int
  uploadedAt DateTime @default(now())
}
